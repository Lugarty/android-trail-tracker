<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/configuracoes"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tipo_mapa"
        android:textSize="18sp"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/radioTipoMapa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <RadioButton
            android:id="@+id/radioVetorial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vetorial_default"
            android:checked="true" />

        <RadioButton
            android:id="@+id/radioSatelite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/satelite" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/navegacao"
        android:textSize="18sp"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/radioNavegacao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp">

        <RadioButton
            android:id="@+id/radioNorthUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/north_up_default"
            android:checked="true" />

        <RadioButton
            android:id="@+id/radioCourseUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/course_up" />
    </RadioGroup>

    <Button
        android:id="@+id/btnSalvarConfig"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/salvar"
        android:layout_gravity="center_horizontal" />

</LinearLayout>